# Reverse proxy for Jellyfin on a Saphi TV (Option A).
#
#   /tv/*   the Saphi shell (saphi.js, config.js) and the probe
#   /*      Jellyfin; jellyfin-web's index.html gets the shell injected
#
# ${JELLYFIN_URL} is filled in by the nginx image's envsubst step at start-up.

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    server_name _;
    client_max_body_size 50m;

    location /tv/ {
        alias /usr/share/nginx/shell/;
        add_header Cache-Control "no-cache";
    }

    location /tv/probe/ {
        alias /usr/share/nginx/probe/;
        add_header Cache-Control "no-cache";
    }

    location = /tv/log {
        # Dev log sink: entries show up in `docker compose logs`.
        access_log off;
        return 204;
    }

    location = / {
        return 302 /web/;
    }

    # jellyfin-web's start page: ask for plain, uncached HTML and inject the shell.
    location ~ ^/web/(index\.html)?$ {
        proxy_pass ${JELLYFIN_URL};
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header Accept-Encoding "";
        proxy_set_header If-None-Match "";
        proxy_set_header If-Modified-Since "";
        proxy_hide_header ETag;
        proxy_hide_header Last-Modified;
        add_header Cache-Control "no-cache";

        sub_filter_once on;
        sub_filter '</head>' '<script src="/tv/config.js"></script><script src="/tv/saphi.js"></script></head>';
    }

    location / {
        proxy_pass ${JELLYFIN_URL};
        proxy_http_version 1.1;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $http_host;
        # WebSocket (/socket) for live updates and remote control
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        # Streaming: no buffering, long reads
        proxy_buffering off;
        proxy_read_timeout 1h;
    }
}
